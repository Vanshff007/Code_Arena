# Server
NODE_ENV=development
PORT=5000

# MongoDB (Atlas connection string in production)
MONGO_URI=mongodb://127.0.0.1:27017/codearena

# CORS - the frontend origin(s) allowed to call this API / open a socket.
# Comma-separated if you need more than one (e.g. apex + www, or staging + prod).
CLIENT_URL=http://localhost:5173

# Auth - generate your own secret, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Must be at least 32 characters - the app refuses to start otherwise.
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Optional error tracking (Sentry project DSN). Leave empty to turn it off.
SENTRY_DSN=

# Optional password reset emails over SMTP. For Gmail: turn on 2-step
# verification, create an app password (Google account > Security > App
# passwords) and put it in SMTP_PASS. Leave SMTP_USER empty to turn email off.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=CodeArena <you@gmail.com>
